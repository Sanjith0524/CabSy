# ============================================================
# CABSY — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it is already in .gitignore).
# ============================================================

# --- Session signing secret (REQUIRED) ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to serve authenticated requests in production without this.
JWT_SECRET=""

# --- Hosted database (REQUIRED on serverless hosts such as Vercel) ---
# When unset, local dev / persistent single-server hosts use a cabsy.db file.
# On Vercel/Lambda the app throws at startup instead — a local file there is
# ephemeral and per-instance.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# --- Gmail SMTP for OTP + notification emails (server-side; keep secret) ---
SMTP_USER=""
SMTP_PASS=""

# --- Optional ---
# Link base used in notification emails (defaults to the prod URL).
# NEXT_PUBLIC_APP_URL="https://cabsy-10.vercel.app"
# Protects /api/cron/sweep. Vercel injects it as a Bearer token automatically.
# CRON_SECRET=""
# Turns this deployment into the public demo (guest login, seeded data). See DEMO.md.
# NEXT_PUBLIC_DEMO_MODE="true"
