# ============================================================
# CABSY — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it is already in .gitignore).
# ============================================================

# --- Firebase config (client-side; safe to expose) ---
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# --- Allowed college email domains (comma-separated, no spaces) ---
NEXT_PUBLIC_ALLOWED_DOMAINS=vitstudent.ac.in,vit.ac.in

# --- Session signing secret (REQUIRED) ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to serve authenticated requests in production without this.
JWT_SECRET=""

# --- Gmail SMTP for OTP emails (server-side; keep secret) ---
SMTP_USER=""
SMTP_PASS=""

# --- Hosted database (REQUIRED on serverless hosts such as Vercel) ---
# When unset, local dev and persistent single-server hosts use a cabsy.db
# file. On Vercel/Lambda the app throws at startup instead, because a local
# file there is ephemeral and per-instance.
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN=""
