rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isCollegeEmail() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*@vitstudent\\.ac\\.in') ||
        request.auth.token.email.matches('.*@vit\\.ac\\.in')
      );
      // Add more domains here as needed, following the same pattern.
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isCollegeEmail();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false; // never delete user records via client
    }

    // ── Rides ─────────────────────────────────────────────────────────────────
    match /rides/{rideId} {
      allow read: if isCollegeEmail();
      allow create: if isCollegeEmail()
        && request.resource.data.creatorUid == request.auth.uid
        && request.resource.data.seatsTotal >= 1
        && request.resource.data.seatsTotal <= 6;
      allow update: if isCollegeEmail()
        && (
          // Creator can update anything
          resource.data.creatorUid == request.auth.uid
          // Members can only update seatsTaken and status via join/leave (enforced server-side via transaction)
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['seatsTaken', 'status'])
          )
        );
      allow delete: if isOwner(resource.data.creatorUid);

      // ── Members subcollection ───────────────────────────────────────────────
      match /members/{memberId} {
        allow read: if isCollegeEmail();
        // Members can only add themselves
        allow create: if isCollegeEmail()
          && request.resource.data.uid == request.auth.uid;
        // Only the ride creator or the member themselves can delete
        allow delete: if isCollegeEmail()
          && (
            resource.data.uid == request.auth.uid
            || get(/databases/$(database)/documents/rides/$(rideId)).data.creatorUid == request.auth.uid
          );
        allow update: if false;
      }

      // ── Messages subcollection ─────────────────────────────────────────────
      match /messages/{messageId} {
        allow read: if isCollegeEmail();
        // Only members can write messages; content must be from themselves
        allow create: if isCollegeEmail()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text.size() <= 500
          && exists(/databases/$(database)/documents/rides/$(rideId)/members/$(request.auth.uid));
        allow update: if false; // no editing messages
        allow delete: if false; // deletion handled by Cloud Functions / TTL
      }
    }
  }
}
